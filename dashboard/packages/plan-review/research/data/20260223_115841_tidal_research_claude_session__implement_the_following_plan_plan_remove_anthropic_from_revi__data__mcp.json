{
  "mcpServers": {
    "tidal-dashboard": {
      "command": "node",
      "args": ["dashboard/packages/mcp/dist/index.js"],
      "env": {
        "TIDAL_API_URL": "${TIDAL_API_URL}",
        "TIDAL_API_TOKEN": "${TIDAL_API_TOKEN}"
      }
    },
    "plan-review": {
      "command": "node",
      "args": ["dashboard/packages/plan-review/dist/index.js"],
      "env": {
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "GOOGLE_AI_API_KEY": "${GOOGLE_AI_API_KEY}",
        "TIDAL_ADR_DIR": "${TIDAL_ADR_DIR}"
      }
    }
  }
}
